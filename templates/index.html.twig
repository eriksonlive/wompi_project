{% extends 'base.html.twig' %}

{% block title %}
	Hello ExampleController!
{% endblock %}

{% block body %}

	<div class="text-center mb-3">
		<h2 class="text-2xl font-bold">Botones de pago WOMPI</h2>
	</div>

	<table class="table-auto w-full border-collapse border border-gray-200">
		<thead>
			<tr>
				<th>ID Pago</th>
				<th>Cliente</th>
				<th>Numero Cliente</th>
				<th>ID Transacción</th>
				<th>Fecha creación</th>
				<th>Valor</th>
				<th>Estado</th>
				<th>Boton</th>
			</tr>
		</thead>
		<tbody class="text-center">
			{% for payment in payments %}
				<tr>
					<td>{{ payment.id }}</td>
					<td>{{ payment.customer.name }}</td>
					<td>{{ payment.customer.customernumber }}</td>
					<td>{{ payment.idTransaccion }}</td>
					<td>{{ payment.createdAt|date('Y-m-d H:i:s') }}</td>
					<td>{{ payment.valor }}</td>
					<td>{{ payment.estado }}</td>
					<td>
						<div class="flex justify-center space-x-2 py-2">

							{% set vencimiento = payment.vigenciaLink|date('U') %}
							{% set ahora = "now"|date('U') %}

							{% if payment.estado != 'APPROVED' and vencimiento > ahora %}
								<a href="{{ payment.link }}" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" target="_blank">
									Pagar
								</a>
							{% elseif payment.estado != 'APPROVED' and vencimiento <= ahora %}
								<span class="text-red-600 font-bold">Link Expirado</span>
							{% else %}
								<span class="text-green-600 font-bold">Pago Aprobado</span>
							{% endif %}

						</div>
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
